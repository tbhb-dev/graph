    "github>tbhb-dev/renovate-config//python.json5#ad8b77a732a0855deb411341b56296e58c1cc537", // main
  ],

  // graph: one Bazel module and one uv project, no Go, so no go.json5.
  // Nothing local is needed beyond the presets.
}
